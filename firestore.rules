
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This rule matches individual documents within the 'contracts' collection
    match /contracts/{contractId} {
      // Allow authenticated users to get a single document
      allow get: if request.auth != null;

      // Allow authenticated users to write (create, update, delete) a single document
      allow write: if request.auth != null;

      // This allows access to any subcollections under a contract document
      match /{allPaths=**} {
        allow read, write: if request.auth != null;
      }
    }
    // This rule specifically matches the 'contracts' collection itself, for list operations
    match /contracts {
        // Allow ANY user (authenticated or not) to list all documents in the collection
        allow list: if true;
    }
  }
}
