
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read and write to the entire database.
    // This is a permissive rule for development.
    // For production, you should restrict access further.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Specifically allow listing contracts for authenticated users,
    // which is needed for the filtering query to work with an index.
    match /contracts/{contractId} {
      allow list: if request.auth != null;
    }
  }
}
