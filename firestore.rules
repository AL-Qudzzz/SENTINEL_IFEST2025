
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Aturan untuk koleksi 'contracts'
    match /contracts/{contractId} {
      
      // Izinkan pengguna yang sudah login untuk membaca (get) atau menulis (create, update, delete) dokumen kontrak individu.
      allow get, write: if request.auth != null;
      
      // Izinkan pengguna yang sudah login untuk membaca (list) seluruh koleksi 'contracts'.
      allow list: if request.auth != null;

      // Aturan untuk sub-koleksi 'comments'
      match /comments/{commentId} {
        // Izinkan baca dan tulis komentar jika pengguna sudah login.
        allow read, write: if request.auth != null;
      }

      // Aturan untuk sub-koleksi 'approvals'
      match /approvals/{approvalId} {
        // Izinkan baca dan tulis langkah persetujuan jika pengguna sudah login.
        allow read, write: if request.auth != null;
      }
    }
  }
}
