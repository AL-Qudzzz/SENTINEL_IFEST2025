
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: These rules are permissive and are intended for development purposes only.
    // They allow any authenticated user to read and write to the entire database.
    // You should secure your database with more specific rules before production.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
