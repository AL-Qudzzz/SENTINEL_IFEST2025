/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a combination of user-ownership and role-based access control for the Sentinel contract management application.
 *
 * Data Structure:
 * - User profiles are stored under `/users/{userId}` and are accessible only to the owning user.
 * - Company and Department data is stored in top-level collections (`/companies/{companyId}`, `/departments/{departmentId}`).  For this prototyping phase, read access is public, but write access is restricted.
 * - Contracts are stored in the `/contracts/{contractId}` collection.  Access control relies on a denormalized `members` map on each contract document, allowing for collaborative access. Subcollections of `/contracts/{contractId}` inherit this access control.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Data validation is minimal in this prototyping phase. Only fields required for authorization are validated.
 * - All destructive operations (`update`, `delete`) require verifying the existence of the document.
 * - Read access to companies and departments is public for prototyping.
 *
 * Denormalization for Authorization:
 * - Contract documents in `/contracts/{contractId}` should contain a `members` map with user IDs as keys and roles as values. This enables simple access control checks based on the authenticated user's role in the contract.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource and the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the authenticated user has the 'owner' role in the members map
     */
    function isContractOwner() {
        return resource.data.members[request.auth.uid] == 'owner';
    }

    /**
     * @description Checks if the authenticated user is a member of the contract
     */
    function isContractMember() {
        return request.auth.uid in resource.data.members;
    }

    /**
     * @description Checks if the authenticated user is creating a document with a valid owner id
     */
    function isValidOwnerId(userId) {
      return request.resource.data.id == userId;
    }


    /**
     * @description Defines access rules for user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     * @allow (get, update, delete) Authenticated user with ID 'user123' can get, update, and delete their profile.
     * @deny (create) User with ID 'user456' cannot create a profile with ID 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // User listing is not allowed.
      allow create: if isOwner(userId) && isValidOwnerId(userId);
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id; // Enforce immutability of user ID.
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines access rules for companies.
     * @path /companies/{companyId}
     * @allow (get, list) Any user can read company data.
     * @deny (create, update, delete) Only authenticated users can create, update, or delete company data.
     * @principle Read access is public, write access is restricted for prototyping.
     */
    match /companies/{companyId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add role-based access control for company data.
    }

    /**
     * @description Defines access rules for departments.
     * @path /departments/{departmentId}
     * @allow (get, list) Any user can read department data.
     * @deny (create, update, delete) Only authenticated users can create, update, or delete department data.
     * @principle Read access is public, write access is restricted for prototyping.
     */
    match /departments/{departmentId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add role-based access control for department data.
    }

    /**
     * @description Defines access rules for contracts.
     * @path /contracts/{contractId}
     * @allow (get) Any authenticated user who is a member of the contract can read it.
     * @allow (create) Any authenticated user can create a contract. They will need to add themselves as a member to manage the contract.
     * @allow (update, delete) Only a contract owner can update or delete the contract.
     * @principle Access control based on membership, enforced via a `members` map on the document.
     */
    match /contracts/{contractId} {
      allow get: if isSignedIn() && isContractMember();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isContractOwner() && resource != null;
      allow delete: if isSignedIn() && isContractOwner() && resource != null;
    }

    /**
     * @description Defines access rules for contract documents.
     * @path /contracts/{contractId}/documents/{documentId}
     * @allow (get) Any authenticated user who is a member of the parent contract can read the document.
     * @allow (create) Any authenticated user who is a member of the parent contract can create a document.
     * @allow (update, delete) Only a contract owner of the parent contract can update or delete the document.
     * @principle Access control inherited from the parent contract's `members` map.
     */
    match /contracts/{contractId}/documents/{documentId} {
      allow get: if isSignedIn() && get(/databases/$(database)/documents/contracts/$(contractId)).data.members[request.auth.uid] != null;
      allow list: if isSignedIn() && get(/databases/$(database)/documents/contracts/$(contractId)).data.members[request.auth.uid] != null;
      allow create: if isSignedIn() && get(/databases/$(database)/documents/contracts/$(contractId)).data.members[request.auth.uid] != null;
      allow update: if isSignedIn() && isContractOwner() && get(/databases/$(database)/documents/contracts/$(contractId)).data.members[request.auth.uid] == 'owner' && resource != null;
      allow delete: if isSignedIn() && isContractOwner() && get(/databases/$(database)/documents/contracts/$(contractId)).data.members[request.auth.uid] == 'owner' && resource != null;
    }

    /**
     * @description Defines access rules for contract notifications.
     * @path /contracts/{contractId}/notifications/{notificationId}
     * @allow (get) Any authenticated user who is a member of the parent contract can read the notification.
     * @allow (create) Any authenticated user who is a member of the parent contract can create a notification.
     * @allow (update, delete) Only a contract owner of the parent contract can update or delete the notification.
     * @principle Access control inherited from the parent contract's `members` map.
     */
    match /contracts/{contractId}/notifications/{notificationId} {
      allow get: if isSignedIn() && get(/databases/$(database)/documents/contracts/$(contractId)).data.members[request.auth.uid] != null;
      allow list: if isSignedIn() && get(/databases/$(database)/documents/contracts/$(contractId)).data.members[request.auth.uid] != null;
      allow create: if isSignedIn() && get(/databases/$(database)/documents/contracts/$(contractId)).data.members[request.auth.uid] != null;
      allow update: if isSignedIn() && isContractOwner() && get(/databases/$(database)/documents/contracts/$(contractId)).data.members[request.auth.uid] == 'owner' && resource != null;
      allow delete: if isSignedIn() && isContractOwner() && get(/databases/$(database)/documents/contracts/$(contractId)).data.members[request.auth.uid] == 'owner' && resource != null;
    }

    /**
     * @description Defines access rules for clause risk assessments.
     * @path /contracts/{contractId}/clauseRiskAssessments/{clauseRiskAssessmentId}
     * @allow (get) Any authenticated user who is a member of the parent contract can read the clause risk assessment.
     * @allow (create) Any authenticated user who is a member of the parent contract can create a clause risk assessment.
     * @allow (update, delete) Only a contract owner of the parent contract can update or delete the clause risk assessment.
     * @principle Access control inherited from the parent contract's `members` map.
     */
    match /contracts/{contractId}/clauseRiskAssessments/{clauseRiskAssessmentId} {
      allow get: if isSignedIn() && get(/databases/$(database)/documents/contracts/$(contractId)).data.members[request.auth.uid] != null;
      allow list: if isSignedIn() && get(/databases/$(database)/documents/contracts/$(contractId)).data.members[request.auth.uid] != null;
      allow create: if isSignedIn() && get(/databases/$(database)/documents/contracts/$(contractId)).data.members[request.auth.uid] != null;
      allow update: if isSignedIn() && isContractOwner() && get(/databases/$(database)/documents/contracts/$(contractId)).data.members[request.auth.uid] == 'owner' && resource != null;
      allow delete: if isSignedIn() && isContractOwner() && get(/databases/$(database)/documents/contracts/$(contractId)).data.members[request.auth.uid] == 'owner' && resource != null;
    }
  }
}