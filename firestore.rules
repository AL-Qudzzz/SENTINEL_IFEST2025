rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow logged-in users to read and write to the 'contracts' collection
    // and its subcollections.
    match /contracts/{contractId} {
      // Allow reading a single document and the entire collection list
      allow get, list: if request.auth != null;

      // Allow creating, updating, and deleting documents
      allow write: if request.auth != null;
      
      // Allow access to subcollections like comments and approvals
      match /{allPaths=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Default-deny all other access
    match /{document=**} {
      allow read, write: if 
          path[0] == 'contracts' ? request.auth != null :
          false;
    }
  }
}
