rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /contracts/{contractId} {
      // Allow authenticated users to read, update, and delete individual contracts.
      allow read, update, delete: if request.auth != null;
    }
    match /contracts {
      // Allow authenticated users to list all contracts and create new ones.
      allow list, create: if request.auth != null;
    }
  }
}
